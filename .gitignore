# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets and local settings
.env
.env.*
!.env.example

# Generated desktop-extension bundle and scratch spikes
build/
*.mcpb
.spike/

# Runtime output: the system's write locations (any depth: v0 keeps them under MCP-PlugIn/data/)
outbox/
**/data/runtime/

# Never commit client material. Only synthetic or public data belongs here.
**/data/client/
**/*CONFIDENTIAL*
**/*Ingenus_internal*
*.docx
*.msg
*.eml

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Personal Claude Code settings for this project (not committed)
.claude/settings.local.json

# Node dependencies (the Claude Desktop bridge); restored with npm ci from package-lock.json
node_modules/

# QA test-case workbooks (local, not committed)
docs/QA/*.xlsx

# Local server settings (ids and paths for a developer laptop); copy .env.example to .env to make one
**/.env

# Local secrets (the certificate private key): the whole folder is ignored
MCP-Server/secrets/

# BEGIN AI-DLC:gitignore
# AI-DLC: local working files
aidlc/active-space
aidlc/spaces/*/intents/active-intent
aidlc/.aidlc-clone-id
aidlc.settings.local.json
aidlc/.aidlc-unit-scope.json
aidlc/.aidlc-unit-parked
aidlc/.aidlc-claim-generations.json
aidlc/.aidlc-unit-participant
aidlc/.aidlc-claim-registry.json
aidlc/.aidlc-unit-releases/
aidlc/.aidlc-unit-merges/
aidlc/.aidlc-active-space-*.tmp
aidlc/active-memory/
aidlc/.aidlc-sessions/
aidlc/.aidlc-request-text/
aidlc/spaces/*/intents/.aidlc-*
**/aidlc/spaces/*/intents/**/.aidlc-engine/
**/aidlc/spaces/*/intents/**/.aidlc-sensors/
aidlc/spaces/*/knowledge/documentkb/.journal/
aidlc/spaces/*/knowledge/.sources.local.json
aidlc/spaces/*/intents/*/runtime-graph.json
aidlc/spaces/*/intents/*/.aidlc-*
aidlc/diagnostics/
.claude/settings.local.json
# END AI-DLC:gitignore
