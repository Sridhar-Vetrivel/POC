# Copy to .env (git-ignored) and fill in. The server reads it at start-up on a developer laptop.
# These are ids and file paths. None of them is a secret. The certificate's private key stays in its own
# file in MCP-Server/secrets/ (git-ignored; see developer_guide.md, "Secrets and local settings"); only its
# path is written here, and a relative path is read from MCP-Server/. On a VM, set the same names as service environment variables
# instead of using a file.

# Where the contracts come from: local (default), sharepoint, onedrive or network
INGENUS_DOC_SOURCE=local
# Or read several sources at once, with nothing to change per question (replaces INGENUS_DOC_SOURCE).
# A file's document_id then starts with its source, for example sharepoint:Chain_A/... Each source uses
# its own settings below. A source that cannot be read is reported; the others still answer.
# INGENUS_SOURCES=sharepoint,onedrive,network
# Seconds to wait for all sources to list their files (default 45)
# INGENUS_SOURCES_TIMEOUT=45
# INGENUS_SP_SITE_URL=https://<tenant>.sharepoint.com/sites/<site>
# INGENUS_SP_FOLDER=General/synthetic/contracts
# OneDrive (INGENUS_DOC_SOURCE=onedrive): a folder in the signed-in user's own OneDrive
# INGENUS_OD_FOLDER=Ingenus_POC/contracts
# Network share (INGENUS_DOC_SOURCE=network): a UNC or mounted path, read as the account the server runs as
# INGENUS_NETWORK_ROOT=\\server\share\contracts
# Seconds to wait for the share before the call fails (default 20)
# INGENUS_NETWORK_TIMEOUT=20
# Optional: copy every audit event to a central store, and where check records are kept
# INGENUS_AUDIT_STORE=MCP-Server/data/runtime/audit.sqlite
# INGENUS_HISTORY_DB=off
# Postgres for BOTH the audit store and the check history (decision 0008). Setting the host switches it on.
# The password lives in a file under MCP-Server/secrets/ (git-ignored), never in this file.
# INGENUS_PG_HOST=127.0.0.1
# INGENUS_PG_PORT=5432
# INGENUS_PG_DB=ingenus_audit
# INGENUS_PG_USER=postgres
# INGENUS_PG_PASSWORD_FILE=secrets/pg_password.txt
# INGENUS_PG_SCHEMA=public
# Age limit for `python -m ingenus_mcp.audit prune` (days)
# INGENUS_RETENTION_DAYS=365

# Server sign-in: off (default; loopback only) or entra
INGENUS_AUTH=off
INGENUS_TENANT_ID=<Directory (tenant) ID>
INGENUS_SERVER_CLIENT_ID=<Application (client) ID of "Ingenus POC MCP Server">
INGENUS_CERT_KEY_FILE=secrets/server_key.pem
INGENUS_CERT_THUMBPRINT=<SHA-1 thumbprint of the certificate uploaded to the server app, hex>
# Only for scripts/signin_check.py: the "Ingenus POC Desktop Client" app id
INGENUS_CLIENT_ID=<Application (client) ID of the desktop client>
