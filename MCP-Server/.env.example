# Copy to .env (git-ignored) and fill in the <...> values. The server reads it at start-up on a developer laptop.
# These are ids and file paths. None of them is a secret. The certificate's private key is in secrets/ (git-ignored;
# see developer_guide.md, "Secrets and local settings"); only its path is written here, and a relative path is
# read from MCP-Server/. On a VM, set the same names as service environment variables instead of using a file.

# Where the contracts come from: all three sources at once. A question finds its files in whichever source
# holds them, so nothing here changes per question. A file's document_id starts with its source, for example
# sharepoint:Chain_A/... A source that cannot be read is reported; the others still answer.
# (To read one source only, use INGENUS_DOC_SOURCE=local, sharepoint, onedrive or network instead of this line.)
INGENUS_SOURCES=sharepoint,onedrive,network
# Seconds to wait for all sources to list their files (default 45)
INGENUS_SOURCES_TIMEOUT=45

# SharePoint: a folder in the site's default library
INGENUS_SP_SITE_URL=https://<tenant>.sharepoint.com/sites/<site>
INGENUS_SP_FOLDER=General/synthetic/contracts
# OneDrive: a folder in the signed-in user's own OneDrive
INGENUS_OD_FOLDER=Ingenus_POC/contracts
# Network share: a UNC or mounted path, read as the account the server runs as
INGENUS_NETWORK_ROOT=\\server\share\contracts
# Seconds to wait for the share before the call fails (default 20)
INGENUS_NETWORK_TIMEOUT=20
# SharePoint and OneDrive folders listed at the same time (default 6; 1 = one after another)
INGENUS_LIST_WORKERS=6

# Server sign-in (Entra): off (default; loopback only) or entra
INGENUS_AUTH=entra
INGENUS_TENANT_ID=<Directory (tenant) ID>
INGENUS_SERVER_CLIENT_ID=<Application (client) ID of "Ingenus POC MCP Server">
INGENUS_CERT_KEY_FILE=secrets/server_key.pem
INGENUS_CERT_THUMBPRINT=<SHA-1 thumbprint of the certificate uploaded to the server app, hex>
# Only for scripts/signin_check.py: the "Ingenus POC Desktop Client" app id
INGENUS_CLIENT_ID=<Application (client) ID of the desktop client>

# Postgres for the audit store, the check history, stored contract terms and search (decision 0008).
# Setting the host switches it on. The password lives in a file under secrets/ (git-ignored), never in this file.
INGENUS_PG_HOST=127.0.0.1
INGENUS_PG_PORT=5432
INGENUS_PG_DB=ingenus_audit
INGENUS_PG_USER=ingenus_server
INGENUS_PG_PASSWORD_FILE=secrets/pg_password.txt
INGENUS_PG_SCHEMA=public
# Age limit for `python -m ingenus_mcp.audit prune` (days)
INGENUS_RETENTION_DAYS=365

# Meaning search (decision 0013): off unless a model is named. nomic, bge, minilm, or off.
# Download the model once with `python -m ingenus_mcp.embeddings fetch`: the server never downloads.
# Needs Postgres with pgvector.
INGENUS_EMBED_MODEL=nomic

# Optional: leave these out to keep the defaults. Uncomment only to change them.
# Copy every audit event to a central store, and where check records are kept:
# INGENUS_AUDIT_STORE=MCP-Server/data/runtime/audit.sqlite
# INGENUS_HISTORY_DB=off
# Stored contract terms (decision 0011): a file, or off. Default: Postgres when INGENUS_PG_HOST is set, else data/runtime/records.sqlite
# INGENUS_RECORDS_DB=off
# Where the embedding model files are kept, and the lowest similarity for a meaning hit
# INGENUS_EMBED_DIR=data/runtime/models
# INGENUS_EMBED_MIN_SIM=0.55
